[Unit]
Description=Sania Pet — Ficha Medica Veterinaria (Go Monolith)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/saniv2
ExecStart=/opt/saniv2/saniapet
Restart=always
RestartSec=3
Environment=PORT=3000
Environment=APP_ENV=production
Environment=APP_NAME=Sania Pet — Ficha Medica Veterinaria
Environment=APP_VERSION=v0.1
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
